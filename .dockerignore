# Keys and your home: never in the image (they come from the /config volume and env_file)
.env
.env*
**/.env*
config.toml
**/config.toml
config.toml.*
!config.example.toml
agent-links.json
agent-url
connect-code
!demo/config.toml

# Private notes, tests, docs and build output
internal/
tests/
docs/
public/
.git
.github/
*.md

# Local tools and caches
.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.claude/
.codex/
.cursor/
.gemini/
.grok/
.gstack/
.impeccable/
.superpowers/
.vercel/
vercel.json
requirements-dev.txt

# Scripts the server doesn't need, and ./homeair, which runs them through scripts/run.sh. check_config.py and setup.py stay: DEPLOYMENT.md checks the config and the
# live page from inside the container (docker compose exec ... scripts/setup.py --live)
scripts/*
!scripts/check_config.py
!scripts/setup.py
homeair
tools/

# The container files themselves
Dockerfile
docker-compose.yml
.dockerignore
history.sqlite*
alerts.sqlite*
# What setup.py --home-server prepares to copy to a server: a copy of the settings and keys
home-server/
local-addresses.json
