# Example of the lines in .env. SETUP.md says how to add them. Never commit .env.

# AirGradient API token (from app.airgradient.com)
AIRGRADIENT_TOKEN=your_token_here

# Google Pollen API key (from Google Cloud Console > Maps Platform)
GOOGLE_POLLEN_API_KEY=your_key_here

# Optional. Other names Home Air at home answers to, comma-separated (your own domain behind a reverse proxy).
# Addresses typed as digits, machine names, .local, .lan, .home, .fritz.box and Tailscale names work without this line.
# HOME_AIR_HOSTS=air.example.com
