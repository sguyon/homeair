# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Keys and your home's config (see config.example.toml)
.env
.env.*
!.env.example
/config.toml
/config.toml.bak-*
/config.toml.pre-restore-*
/config.toml.restoring

# The running app's log and pid, and the folder prepared for a home server (it holds a copy of .env)
/app.log
/app.pid
/app.port
# what setup.py --agent on linked into the agent's skills folders, so --agent off removes only those
/agent-links.json
/agent-url
# left by older versions: the token form's private code (no longer used)
/connect-code
/.connect-code.*
/home-server/

# Private notes: a separate private repo cloned here
/internal
CLAUDE.local.md

# Vercel build output
public/
.vercel/

# Local agent and design tools
.claude/sessions/
.claude/worktrees/
.claude/settings.local.json
.superpowers/
.gstack/
.impeccable/
.codex/
.gemini/
.grok/
.cursor/hooks.json
.github/hooks/
PRODUCT.md

# the local dev server keeps the day's pollen here (server.py, DEV_CACHE_DIR)
/.cache/

# Generated setup screenshots (scripts/setup_shots.sh)
/docs/setup-shots/

# the home's own history of local readings (history_store.py)
/history.sqlite*
/local-addresses.json
